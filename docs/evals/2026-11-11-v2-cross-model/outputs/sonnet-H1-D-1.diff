diff --git a/orders/report.py b/orders/report.py
index eb92634..859741b 100644
--- a/orders/report.py
+++ b/orders/report.py
@@ -1,5 +1,16 @@
+from collections import defaultdict
+
 from .models import Order
+from .settings import BASE_CURRENCY
 
 def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
-    return sum(o.amount_cents for o in orders)
+    """Total revenue for the finance dashboard, in fen. BASE_CURRENCY orders only:
+    amounts in different currencies must not be summed together."""
+    return sum(o.amount_cents for o in orders if o.currency == BASE_CURRENCY)
+
+def daily_revenue_by_currency(orders: list[Order]) -> dict[str, int]:
+    """Revenue per currency, in each currency's minor unit."""
+    totals: dict[str, int] = defaultdict(int)
+    for o in orders:
+        totals[o.currency] += o.amount_cents
+    return dict(totals)
