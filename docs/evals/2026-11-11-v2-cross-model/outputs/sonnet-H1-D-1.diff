@@ -11,3 +11,15 @@ def test_daily_revenue():
 
 def test_payload_has_fields():
     assert '"amount_cents": 100' in order_created_payload(_o(1, 100))
+
+def test_payload_omits_currency_for_v1_schema():
+    import json
+    o = Order(id=1, customer_id=1, amount_cents=100, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert set(json.loads(order_created_payload(o))) == {"id", "customer_id", "amount_cents", "created_at"}
+
+def test_revenue_does_not_mix_currencies():
+    from orders.report import daily_revenue_by_currency
+    eur = Order(id=3, customer_id=1, amount_cents=999, created_at=datetime(2026, 11, 1), currency="EUR")
+    orders = [_o(1, 100), _o(2, 250), eur]
+    assert daily_revenue(orders) == 350
+    assert daily_revenue_by_currency(orders) == {"CNY": 350, "EUR": 999}
