@@ -5,5 +5,8 @@ from .models import Order
 def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
+    # v1 schema is strict (additionalProperties: false); Acme drops payloads with
+    # unknown fields. Don't send currency until a v2 schema is agreed (docs/partners.md).
+    body.pop("currency")
     body["created_at"] = order.created_at.isoformat()
     return json.dumps(body)
diff --git a/tests/test_orders.py b/tests/test_orders.py
index 8f9f2f0..cbf244b 100644
--- a/tests/test_orders.py
