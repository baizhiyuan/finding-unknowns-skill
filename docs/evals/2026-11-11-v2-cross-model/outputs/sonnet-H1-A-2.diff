--- a/orders/webhook.py
+++ b/orders/webhook.py
@@ -5,5 +5,8 @@ from .models import Order
 def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
+    # schemas/webhook_order_v1.json is strict (additionalProperties: false); Acme drops
+    # payloads with unknown fields. Keep currency out until a v2 schema is agreed (docs/partners.md).
+    body.pop("currency")
     body["created_at"] = order.created_at.isoformat()
     return json.dumps(body)
