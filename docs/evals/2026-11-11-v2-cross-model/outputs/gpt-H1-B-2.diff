+def order_created_payload(order: Order, *, version: int = 1) -> str:
+    """Body for the partner's agreed schema version (see docs/partners.md)."""
+    if version not in (1, 2):
+        raise ValueError(f"Unsupported webhook version: {version}")
+    if version == 1 and order.currency != BASE_CURRENCY:
+        raise ValueError("Non-CNY orders require the v2 webhook contract")
+    body = {
+        "id": order.id,
+        "customer_id": order.customer_id,
+        "amount_cents": order.amount_cents,
+        "created_at": order.created_at.isoformat(),
+    }
+    if version == 2:
+        body["currency"] = order.currency
     return json.dumps(body)
