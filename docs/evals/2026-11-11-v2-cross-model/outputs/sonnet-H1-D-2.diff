index eb92634..9a1d1af 100644
--- a/orders/report.py
+++ b/orders/report.py
@@ -1,5 +1,9 @@
 from .models import Order
+from .settings import BASE_CURRENCY
 
 def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
-    return sum(o.amount_cents for o in orders)
+    """Total revenue for the finance dashboard, in fen (BASE_CURRENCY only).
+
+    Orders in other currencies are excluded: their minor units can't be summed with fen.
+    """
+    return sum(o.amount_cents for o in orders if o.currency == BASE_CURRENCY)
diff --git a/orders/webhook.py b/orders/webhook.py
index 45cc763..04d05d9 100644
--- a/orders/webhook.py
+++ b/orders/webhook.py
@@ -2,8 +2,14 @@ import json
 from dataclasses import asdict
 from .models import Order
 
+# Fields not in schemas/webhook_order_v1.json. Acme rejects unknown fields and drops the
+# delivery, so these must stay out of the payload until a v2 schema is agreed (docs/partners.md).
+_NOT_IN_V1 = ("currency",)
+
 def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
+    for field in _NOT_IN_V1:
+        body.pop(field, None)
     body["created_at"] = order.created_at.isoformat()
     return json.dumps(body)
diff --git a/tests/test_orders.py b/tests/test_orders.py
index 8f9f2f0..e2a2139 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -11,3 +11,18 @@ def test_daily_revenue():
 
 def test_payload_has_fields():
     assert '"amount_cents": 100' in order_created_payload(_o(1, 100))
+
+def test_currency_defaults_to_cny():
+    assert _o(1, 100).currency == "CNY"
+
+def test_webhook_payload_excludes_currency():
+    # webhook_order_v1 is strict (additionalProperties: false); see docs/partners.md
+    import json
+    from datetime import datetime
+    o = Order(id=1, customer_id=1, amount_cents=100, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert "currency" not in json.loads(order_created_payload(o))
+
+def test_daily_revenue_ignores_non_base_currency():
+    from datetime import datetime
+    eur = Order(id=3, customer_id=1, amount_cents=999, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert daily_revenue([_o(1, 100), eur]) == 100
