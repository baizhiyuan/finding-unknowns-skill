+from datetime import date, datetime, timedelta, timezone
+
+# Business day boundaries are Asia/Shanghai (UTC+8, no DST). Don't rely on the
+# container's TZ (the image sets TZ=UTC), or runs after local midnight but before
+# 08:00 UTC+8 would see the previous day as "today".
+BUSINESS_TZ = timezone(timedelta(hours=8))
+
+def today() -> date:
+    return datetime.now(BUSINESS_TZ).date()
 
