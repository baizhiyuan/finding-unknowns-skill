     created_at: datetime
+    currency: str = BASE_CURRENCY  # ISO 4217; legacy orders are CNY
diff --git a/orders/webhook.py b/orders/webhook.py
index 45cc763..8371535 100644
--- a/orders/webhook.py
+++ b/orders/webhook.py
@@ -5,5 +5,8 @@ from .models import Order
 def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
+    # v1 schema is strict (additionalProperties: false); `currency` needs a v2 schema
+    # and 30 days' notice to Acme (docs/partners.md). Do not leak it into v1.
+    body.pop("currency")
     body["created_at"] = order.created_at.isoformat()
     return json.dumps(body)
