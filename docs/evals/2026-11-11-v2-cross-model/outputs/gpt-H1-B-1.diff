diff --git a/orders/report.py b/orders/report.py
index eb92634..6da60c6 100644
--- a/orders/report.py
+++ b/orders/report.py
@@ -1,5 +1,18 @@
 from .models import Order
+from .settings import BASE_CURRENCY, SUPPORTED_CURRENCIES
 
-def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
+def daily_revenue(orders: list[Order], *, currency: str = BASE_CURRENCY) -> int:
+    """Total in one currency's minor units; rejects other currencies (no FX)."""
+    if currency not in SUPPORTED_CURRENCIES:
+        raise ValueError(f"Unsupported currency: {currency!r}")
+    if any(o.currency != currency for o in orders):
+        raise ValueError("Orders must match the report currency; use daily_revenue_by_currency")
     return sum(o.amount_cents for o in orders)
+
+
+def daily_revenue_by_currency(orders: list[Order]) -> dict[str, int]:
+    """Totals by currency in minor units, without currency conversion."""
+    totals: dict[str, int] = {}
+    for order in orders:
+        totals[order.currency] = totals.get(order.currency, 0) + order.amount_cents
+    return totals
