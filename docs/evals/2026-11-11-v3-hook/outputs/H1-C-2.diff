+
+def test_payload_omits_currency_for_v1_schema():
+    o = Order(id=1, customer_id=1, amount_cents=100, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert "currency" not in order_created_payload(o)
+
+def test_daily_revenue_does_not_mix_currencies():
+    eur = Order(id=2, customer_id=1, amount_cents=999, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert daily_revenue([_o(1, 100), eur]) == 100
+    assert daily_revenue([_o(1, 100), eur], currency="EUR") == 999
