diff --git a/orders/report.py b/orders/report.py
index eb92634..d769919 100644
--- a/orders/report.py
+++ b/orders/report.py
@@ -1,5 +1,9 @@
 from .models import Order
+from .settings import BASE_CURRENCY
 
-def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
-    return sum(o.amount_cents for o in orders)
+def daily_revenue(orders: list[Order], currency: str = BASE_CURRENCY) -> int:
+    """Total revenue for the finance dashboard, in the minor unit (fen/cents) of `currency`.
+
+    Only orders in `currency` are summed; amounts in different currencies must never be added.
+    """
+    return sum(o.amount_cents for o in orders if o.currency == currency)
