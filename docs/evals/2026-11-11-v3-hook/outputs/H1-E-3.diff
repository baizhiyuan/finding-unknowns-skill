+
+def test_currency_defaults_to_cny():
+    assert _o(1, 100).currency == "CNY"
+
+def test_payload_stays_v1_compatible():
+    import json
+    o = Order(id=1, customer_id=1, amount_cents=100, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert "currency" not in json.loads(order_created_payload(o))
+
+def test_daily_revenue_ignores_other_currencies():
+    eur = Order(id=3, customer_id=1, amount_cents=999, created_at=datetime(2026, 11, 1), currency="EUR")
+    assert daily_revenue([_o(1, 100), eur]) == 100
+    assert daily_revenue([_o(1, 100), eur], "EUR") == 999
