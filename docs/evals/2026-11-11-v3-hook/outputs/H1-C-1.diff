diff --git a/orders/webhook.py b/orders/webhook.py
index 45cc763..bda42a3 100644
--- a/orders/webhook.py
+++ b/orders/webhook.py
@@ -2,8 +2,15 @@ import json
 from dataclasses import asdict
 from .models import Order
 
+# Fields that must NOT reach partners until a new schema version is agreed.
+# Acme validates against schemas/webhook_order_v1.json (additionalProperties: false) and
+# drops deliveries with unknown fields; a v2 schema needs 30 days' notice (docs/partners.md).
+_NOT_IN_V1 = ("currency",)
+
 def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
+    for field in _NOT_IN_V1:
+        body.pop(field, None)
     body["created_at"] = order.created_at.isoformat()
     return json.dumps(body)
diff --git a/tests/test_orders.py b/tests/test_orders.py
