@@ -11,3 +11,19 @@ def test_daily_revenue():
 
 def test_payload_has_fields():
     assert '"amount_cents": 100' in order_created_payload(_o(1, 100))
+
+def test_currency_defaults_to_base():
+    assert _o(1, 100).currency == "CNY"
+
+def test_webhook_payload_stays_v1_compatible():
+    import json
+    from pathlib import Path
+    schema = json.loads(Path("schemas/webhook_order_v1.json").read_text())
+    eur = Order(id=1, customer_id=1, amount_cents=100, created_at=datetime(2026, 11, 1), currency="EUR")
+    body = json.loads(order_created_payload(eur))
+    assert set(body) <= set(schema["properties"])
+    assert set(schema["required"]) <= set(body)
+
+def test_cache_schema_bumped():
+    from orders import cache
+    assert cache.CACHE_SCHEMA >= 4
