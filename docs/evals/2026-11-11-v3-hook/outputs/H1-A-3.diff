@@ -1,5 +1,15 @@
+from collections import defaultdict
 from .models import Order
+from .settings import BASE_CURRENCY
+
+def daily_revenue_by_currency(orders: list[Order]) -> dict[str, int]:
+    """Revenue per currency, in each currency's minor unit (fen, euro cents, ...)."""
+    totals: dict[str, int] = defaultdict(int)
+    for o in orders:
+        totals[o.currency] += o.amount_cents
+    return dict(totals)
 
 def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
-    return sum(o.amount_cents for o in orders)
+    """Total revenue for the finance dashboard, in fen. Only counts BASE_CURRENCY orders;
+    amounts in different currencies can't be summed (use daily_revenue_by_currency)."""
+    return daily_revenue_by_currency(orders).get(BASE_CURRENCY, 0)
