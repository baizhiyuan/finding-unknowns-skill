--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -11,3 +11,16 @@ def test_daily_revenue():
 
 def test_payload_has_fields():
     assert '"amount_cents": 100' in order_created_payload(_o(1, 100))
+
+def _eur(i, amt):
+    return Order(id=i, customer_id=1, amount_cents=amt, created_at=datetime(2026, 11, 1), currency="EUR")
+
+def test_currency_defaults_to_base():
+    assert _o(1, 100).currency == "CNY"
+
+def test_webhook_payload_omits_currency_for_v1_schema():
+    import json
+    assert "currency" not in json.loads(order_created_payload(_eur(1, 100)))
+
+def test_daily_revenue_ignores_non_base_currency():
+    assert daily_revenue([_o(1, 100), _eur(2, 999)]) == 100
