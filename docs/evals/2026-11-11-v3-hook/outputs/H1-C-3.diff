diff --git a/orders/report.py b/orders/report.py
index eb92634..600f90d 100644
--- a/orders/report.py
+++ b/orders/report.py
@@ -1,5 +1,7 @@
 from .models import Order
+from .settings import BASE_CURRENCY
 
 def daily_revenue(orders: list[Order]) -> int:
-    """Total revenue for the finance dashboard, in fen."""
-    return sum(o.amount_cents for o in orders)
+    """Total revenue for the finance dashboard, in fen. Only BASE_CURRENCY orders are
+    counted; summing minor units across currencies would be meaningless."""
+    return sum(o.amount_cents for o in orders if o.currency == BASE_CURRENCY)
diff --git a/orders/webhook.py b/orders/webhook.py
index 45cc763..a188cdd 100644
--- a/orders/webhook.py
+++ b/orders/webhook.py
@@ -6,4 +6,7 @@ def order_created_payload(order: Order) -> str:
     """Body POSTed to partners on order creation (see docs/partners.md)."""
     body = asdict(order)
     body["created_at"] = order.created_at.isoformat()
+    # webhook_order_v1 is strict (additionalProperties: false) and Acme drops deliveries
+    # with unknown fields. `currency` needs a v2 schema + 30 days' notice (docs/partners.md).
+    body.pop("currency")
     return json.dumps(body)
diff --git a/tests/test_orders.py b/tests/test_orders.py
